# PA Demo UI Environment Variables
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# VITE_API_URL - Base URL for the PA Demo API.
# In local development, the Vite dev server proxies /api to localhost:3000,
# so the default fallback (/api) works without setting this variable.
# For deployed environments, set this to the API Gateway URL (e.g., https://abc123.execute-api.us-west-2.amazonaws.com/Prod).
VITE_API_URL=/api
